page {
    min-height: 100%;
    background: #f4f8ff;
}
.store-list-page {
    min-height: 100vh;
    padding: 24rpx;
    box-sizing: border-box;
    background: linear-gradient(180deg, #0f66d8 0, #2f8cff 118rpx, #f4f8ff 119rpx);
}
.store-toolbar {
    padding: 22rpx;
    border-radius: 26rpx;
    background: #fff;
    box-shadow: 0 18rpx 46rpx rgba(33, 74, 132, 0.12);
}
.toolbar-row {
    display: flex;
    align-items: center;
}
.toolbar-row.split {
    margin-top: 18rpx;
    gap: 16rpx;
}
.search-box {
    flex: 1;
    display: flex;
    align-items: center;
    height: 78rpx;
    padding: 0 12rpx 0 24rpx;
    border: 1rpx solid #dfeafe;
    border-radius: 20rpx;
    background: #f7fbff;
    box-sizing: border-box;
}
.search-box input {
    flex: 1;
    min-width: 0;
    height: 78rpx;
    color: #172033;
    font-size: 27rpx;
}
.search-box input::placeholder {
    color: #9aaabd;
}
.search-action {
    min-width: 102rpx;
    height: 58rpx;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #0f66d8, #2f8cff);
    color: #fff;
    font-size: 24rpx;
    line-height: 58rpx;
    text-align: center;
    font-weight: 700;
    box-shadow: 0 8rpx 18rpx rgba(15, 102, 216, 0.22);
}
.create-button {
    width: 206rpx;
    height: 74rpx;
    margin: 0;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #0f66d8, #2f8cff);
    color: #fff;
    font-size: 27rpx;
    line-height: 74rpx;
    font-weight: 700;
    box-shadow: 0 10rpx 24rpx rgba(15, 102, 216, 0.24);
}
.region {
    flex: 1;
    min-width: 0;
}
.picker {
    height: 74rpx;
    padding: 0 24rpx;
    border: 1rpx solid #dfeafe;
    border-radius: 20rpx;
    background: #f7fbff;
    color: #172033;
    font-size: 27rpx;
    line-height: 74rpx;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    box-sizing: border-box;
}
.picker::after {
    content: "";
    display: inline-block;
    width: 12rpx;
    height: 12rpx;
    margin-left: 12rpx;
    border-right: 3rpx solid #7b91ad;
    border-bottom: 3rpx solid #7b91ad;
    transform: rotate(45deg) translateY(-4rpx);
}
.weui-panel__bd{
    margin-top: 22rpx;
    padding: 14rpx;
    border-radius: 26rpx;
    background: #fff;
    box-shadow: 0 18rpx 46rpx rgba(33, 74, 132, 0.08);
}
.store-card{
    position: relative;
    min-height: 148rpx;
    margin-bottom: 14rpx;
    padding: 26rpx 26rpx 24rpx;
    border: 1rpx solid #e7effa;
    border-radius: 22rpx;
    background: #f8fbff;
    box-sizing: border-box;
}
.store-card:last-child {
    margin-bottom: 0;
}
.store-card-title {
    padding-right: 70rpx;
    color: #172033;
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 700;
}
.store-card-desc {
    padding-right: 70rpx;
    margin-top: 10rpx;
    color: #71849a;
    font-size: 24rpx;
    line-height: 34rpx;
}
.store-card-actions {
    display: flex;
    margin: 18rpx -6rpx 0;
    flex-wrap: wrap;
}
.state-button {
    min-width: 132rpx;
    height: 54rpx;
    margin: 6rpx;
    padding: 0 18rpx;
    border: 1rpx solid #cfe0ff;
    border-radius: 999rpx;
    color: #49627f;
    background: #fff;
    font-size: 23rpx;
    line-height: 54rpx;
    text-align: center;
    font-weight: 700;
    box-sizing: border-box;
}
.state-button.active {
    border-color: #0f66d8;
    color: #fff;
    background: linear-gradient(135deg, #0f66d8, #2f8cff);
}
.state-button.danger {
    border-color: #ffd5d5;
    color: #d94d4d;
}
.state-button.danger.active {
    border-color: #d94d4d;
    color: #fff;
    background: linear-gradient(135deg, #d94d4d, #ff7474);
}
.state-button.disabled {
    border-color: #d8e0eb;
    color: #9aaabd;
    background: #edf2f8;
    box-shadow: none;
}
.icon-weizhi{
    position: absolute;
    top: 48rpx; 
    right: 28rpx;
    color: #0f66d8;
}
