.map-page {
    position: relative;
    min-height: 100vh;
    background: #f4f8ff;
}
.map {
    width: 100%;
    height: 100vh;
  }

.map-header {
    position: absolute;
    left: 24rpx;
    right: 24rpx;
    top: 24rpx;
    z-index: 2;
    padding: 26rpx 30rpx;
    border-radius: 28rpx;
    color: #fff;
    background: linear-gradient(135deg, #0a58c8 0%, #1677ff 54%, #39a7ff 100%);
    box-shadow: 0 18rpx 44rpx rgba(15, 102, 216, 0.24);
}

.map-kicker {
    font-size: 22rpx;
    line-height: 30rpx;
    color: rgba(255,255,255,.76);
}

.map-title {
    margin-top: 6rpx;
    font-size: 36rpx;
    line-height: 48rpx;
    font-weight: 700;
}
  
.tools{
    position: absolute;
    top: 170rpx;
    right: 24rpx;
    z-index: 3;
    padding: 10rpx;
    border-radius: 24rpx;
    background: rgba(255,255,255,.96);
    box-shadow: 0 18rpx 44rpx rgba(33, 74, 132, 0.16);
}
.tools .button{
    min-width: 148rpx;
    height: 66rpx;
    line-height: 66rpx;
    padding: 0 20rpx;
    border-radius: 999rpx;
    font-size: 24rpx;
    color: #49627f;
    background: #f4f8ff;
    display: block;
    margin-top: 10rpx;
}
.tools .button:first-child {
    margin-top: 0;
}
.tools .button.active{
    color: #fff;
    background: linear-gradient(135deg, #0f66d8, #2f8cff);
    box-shadow: 0 10rpx 24rpx rgba(15, 102, 216, 0.24);
}

.callout-item {
    padding: 10rpx;
    border: 1rpx solid #dce9fb;
    border-radius: 14rpx;
    background-color: #fff;
}

.callout-img {
    height: 60rpx;
    width: 60rpx;
}
.callout-name{
    font-size: 20rpx;
    text-align: center;
    color: #172033;
}

.store-address-card {
    position: absolute;
    left: 24rpx;
    right: 24rpx;
    bottom: 42rpx;
    z-index: 3;
    padding: 26rpx;
    border-radius: 26rpx;
    background: rgba(255,255,255,.98);
    box-shadow: 0 18rpx 46rpx rgba(33, 74, 132, 0.18);
}

.address-title {
    color: #172033;
    font-size: 32rpx;
    line-height: 44rpx;
    font-weight: 700;
}

.address-text {
    margin-top: 10rpx;
    color: #49627f;
    font-size: 25rpx;
    line-height: 36rpx;
}

.nav-button {
    height: 72rpx;
    margin: 22rpx 0 0;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #0f66d8, #2f8cff);
    color: #fff;
    font-size: 26rpx;
    line-height: 72rpx;
    font-weight: 700;
    box-shadow: 0 10rpx 24rpx rgba(15, 102, 216, 0.24);
}
