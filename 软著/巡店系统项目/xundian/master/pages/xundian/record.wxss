
page {
    min-height: 100%;
    background: #f4f8ff;
}
.page {
    min-height: 100vh;
    padding: 28rpx 24rpx;
    box-sizing: border-box;
    background: #f4f8ff;
}
.weui-panel {
    margin-top: 0 !important;
    border-radius: 28rpx;
    overflow: hidden;
    background: #fff !important;
    box-shadow: 0 18rpx 46rpx rgba(33, 74, 132, 0.08);
}
.head-picker{
    display: flex;
    justify-content:flex-start;
    align-items: center;
    padding: 24rpx !important;
    background: #fff;
    color: #26384f;
    font-weight: 700;
}
.icon-arrow-down{
    display: inline;
}
.list-item{
    display:flex;
    margin: 18rpx 20rpx;
    border: 1rpx solid #e7effa;
    border-radius: 24rpx;
    background: #f8fbff;
    overflow: hidden;
}
.list-item-left{
    flex: 1;
    padding: 1rem;
}
.list-item-image{
    width: 100rpx;
    height: 100rpx;
    border-radius: 20rpx;
}
.list-item-content{
    padding: 0.5rem 0;
    width: 100%;
}
.list-item-title{
    font-weight: bold;
    font-size: 30rpx;
    color: #172033;
}
.detail-image{
    position: relative;
    display: inline-block;
    margin: 5rpx;
    border-radius: 5px;
    overflow: hidden;
}
.detail-image image{
    display:block;
}

.detail-time{
    position:absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 2rem;
    height: 2rem;
    text-align: center;
    color: #fff;
    font-size: 0.9rem;
    background-image: linear-gradient(to bottom , rgba(0,0,0, 0), rgba(0, 0, 0, 0.5));
}
.detail-note{
    font-size: 24rpx;
    line-height: 36rpx;
    color: #5d7188;
    padding-right: 1rem;
}
.detail-note .iconfont {
    display: inline;
}
.location {
    position: relative;
    top: -5rpx;
    color: #323742;
}
.delete {
    display: inline;
    position: absolute;
    right: 1.5rem;
    color: #576b95;
}
.task-info{
    background-color: #edf5ff;
    padding:18rpx;
    margin-right: 1rem;
    border-radius: 18rpx;
    margin-bottom: 0.5rem;
    display:flex;
}
.openline {
    color: #0f66d8;
    font-size: 24rpx;
    font-weight: 700;
    flex: 1;
    text-align: right;
    margin: auto 0;
}

.operation{
    position: relative;
    text-align: right;
    padding-right: 1rem;
}
.operation .operation-item{
    font-size: 0.9rem;
    display: inline-block;
}
.operation .operation-item mp-icon{
    position:relative;
    top: -2rpx;
}
.comment{
    position: fixed;
    bottom:0;
    background-color: #f6f8f9;
    padding: 0.5rem;
    width: 100%;
    box-sizing: border-box;
}
.comment input{
    background-color: #fff;
    border-radius: 0.25rem;
    padding: 0.4rem 0.75rem;
}
.comment-list{
    font-size: 24rpx;
    background-color: #edf5ff;
    padding:18rpx;
    margin-right: 1rem;
    border-radius: 18rpx;
}
.comment-item{
    margin-top: 0.25rem;
}
.comment-item view{
    display: inline-block;
}
.comment-list .comment-name{
    color: #204f8d;
}
.more-comments{
    text-align: center;
    font-size: 0.8rem;
}
.color_bule{
    color: #0f66d8;  
    font-weight: 700;
}
