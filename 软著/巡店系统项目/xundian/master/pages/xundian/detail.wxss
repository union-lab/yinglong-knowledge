
.list-item{
    display:flex;
    border-top: 1px solid rgb(236, 236, 236);
    margin-bottom: 5rem;
}
.list-item-left{
    flex: 1;
    padding: 1rem;
}
.list-item-image{
    width: 100rpx;
    height: 100rpx;
    border-radius: 20rpx;
}
.list-item-content{
    padding: 0.5rem 0;
    width: 100%;
}
.list-item-title{
    font-weight: bold;
    font-size: 1rem;
    font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
}
.detail-image{
    position: relative;
    display: inline-block;
    margin: 5rpx;
    border-radius: 5px;
    overflow: hidden;
}
.detail-image image{
    display:block;
}

.detail-time{
    position:absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    line-height: 2rem;
    height: 2rem;
    text-align: center;
    color: #fff;
    font-size: 0.9rem;
    background-image: linear-gradient(to bottom , rgba(0,0,0, 0), rgba(0, 0, 0, 0.5));
}
.detail-note{
    font-size: 0.8rem;
    padding-right: 1rem;
}
.detail-note .iconfont {
    display: inline;
}
.location {
    position: relative;
    top: -5rpx;
    color: #323742;
}
.delete {
    display: inline;
    position: absolute;
    right: 1.5rem;
    color: #576b95;
}
.task-info{
    background-color: #f5f5f5;
    padding:0.5rem;
    margin-right: 1rem;
    border-radius: 0.25rem;
    margin-bottom: 0.5rem;
    display:flex;
}
.openline {
    color: rgb(48, 56, 80);
    font-size: 0.8rem;
    flex: 1;
    text-align: right;
    margin: auto 0;
}

.operation{
    position: relative;
    text-align: right;
    padding-right: 1rem;
}
.operation .operation-item{
    font-size: 0.9rem;
    display: inline-block;
}
.operation .operation-item mp-icon{
    position:relative;
    top: -2rpx;
}
.comment{
    position: fixed;
    bottom:0;
    background-color: #f6f8f9;
    padding: 0.5rem 0.5rem 1.5rem 0.5rem;
    width: 100%;
    box-sizing: border-box;
}
.comment input{
    background-color: #fff;
    border-radius: 0.25rem;
    padding: 0.4rem 0.75rem;
}
.comment-list{
    font-size: 0.8rem;
    background-color: #f5f5f5;
    padding:0.5rem;
    margin-right: 1rem;
    border-radius: 0.25rem;
}
.comment-item{
    margin-top: 0.25rem;
}
.comment-item view{
    display: inline-block;
}
.comment-list .comment-name{
    color: #204f8d;
}
.more-comments{
    text-align: center;
    font-size: 0.8rem;
}