page {
    min-height: 100%;
    background: #f4f8ff;
}

.select-page {
    min-height: 100vh;
    padding: 28rpx 24rpx;
    box-sizing: border-box;
    background: linear-gradient(180deg, #0f66d8 0, #2f8cff 210rpx, #f4f8ff 211rpx);
}

.select-hero {
    padding: 30rpx 30rpx 36rpx;
    color: #fff;
}

.select-kicker {
    font-size: 24rpx;
    line-height: 34rpx;
    color: rgba(255, 255, 255, 0.74);
}

.select-title {
    margin-top: 8rpx;
    font-size: 42rpx;
    line-height: 54rpx;
    font-weight: 700;
    letter-spacing: 0;
}

.shoptourtype-list{
    padding: 14rpx;
    border-radius: 26rpx;
    background-color: #fff;
    box-shadow: 0 18rpx 46rpx rgba(33, 74, 132, 0.08);
}
.shoptourtype-item{
    position: relative;
    min-height: 96rpx;
    margin-bottom: 12rpx;
    padding: 0 78rpx 0 26rpx;
    border: 1rpx solid #e7effa;
    border-radius: 18rpx;
    background: #f8fbff;
    display: flex;
    align-items: center;
  }
  .shoptourtype-item-title{
    font-size: 30rpx;
    line-height: 42rpx;
    font-weight: 600;
    color: #172033;
  }

.select-arrow {
    position: absolute;
    right: 28rpx;
    top: 50%;
    transform: translateY(-50%);
    color: #0f66d8;
    font-size: 42rpx;
    line-height: 42rpx;
}
